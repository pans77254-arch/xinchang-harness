<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="cursor" version="24.0.0"><diagram id="rp1" name="审查点开发做法"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1720" pageHeight="980" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="审查点开发架构（全组按此实现）  ·  以「目录索引一致性」为例" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="28" as="geometry"/></mxCell><mxCell id="sub" value="一张 LangGraph 执行图 + Skill 是规则配置。转 md / YOLO / 抽取是共用工具，审查点禁止自己排工具顺序。" style="text;html=1;align=left;fontSize=11;fontColor=#5d6d7e;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1200" height="20" as="geometry"/></mxCell><mxCell id="L0" value="放哪里" style="swimlane;horizontal=0;startSize=110;html=1;fontStyle=1;fontSize=13;fontColor=#1a365d;fillColor=#d5f5e3;strokeColor=#1e8449;swimlaneFillColor=#eafaf1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1680" height="150" as="geometry"/></mxCell><mxCell id="p_tools" value="工具注册中心&lt;br&gt;ai/tools/&lt;br&gt;MinerU · PDF→PNG · YOLO&lt;br&gt;抽取 · 规则校验函数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#117a65;strokeColor=#0e6655;" vertex="1" parent="L0"><mxGeometry x="130" y="28" width="240" height="100" as="geometry"/></mxCell><mxCell id="p_rules" value="审查规则库 = Skill&lt;br&gt;ai/rules/&lt;br&gt;每条审查点一份 YAML&lt;br&gt;目录一致性挂在这里" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;" vertex="1" parent="L0"><mxGeometry x="400" y="28" width="240" height="100" as="geometry"/></mxCell><mxCell id="p_graph" value="唯一执行工作流&lt;br&gt;ai/graph/controller.py&lt;br&gt;LangGraph 总控 一张图&lt;br&gt;仅平台组可改边" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#d35400;strokeColor=#a04000;" vertex="1" parent="L0"><mxGeometry x="670" y="28" width="240" height="100" as="geometry"/></mxCell><mxCell id="p_comp" value="编译面（平时不跑）&lt;br&gt;ai/compile/&lt;br&gt;形式/P&amp;ID/总图&lt;br&gt;规则转换智能体" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#5d6d9e;strokeColor=#3d4c7a;" vertex="1" parent="L0"><mxGeometry x="940" y="28" width="240" height="100" as="geometry"/></mxCell><mxCell id="p_art" value="工件库 / 图纸库&lt;br&gt;数据层&lt;br&gt;toc · title_block · file_list&lt;br&gt;抽一次全员复用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;" vertex="1" parent="L0"><mxGeometry x="1210" y="28" width="240" height="100" as="geometry"/></mxCell><mxCell id="L1" value="执行面&lt;br&gt;每套图都跑" style="swimlane;horizontal=0;startSize=110;html=1;fontStyle=1;fontSize=13;fontColor=#1a365d;fillColor=#d6eaf8;strokeColor=#1a5276;swimlaneFillColor=#eaf2f8;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="1680" height="200" as="geometry"/></mxCell><mxCell id="n_task" value="后端任务&lt;br&gt;files + skill_ids" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#148f80;strokeColor=#0e6655;" vertex="1" parent="L1"><mxGeometry x="130" y="50" width="150" height="80" as="geometry"/></mxCell><mxCell id="n_ctrl" value="总控智能体&lt;br&gt;invoke(task)&lt;br&gt;读 Skill.needs 并集" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#d35400;strokeColor=#a04000;" vertex="1" parent="L1"><mxGeometry x="320" y="50" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_tools" value="共用工具（只调一次）&lt;br&gt;Word/目录 → MinerU → md&lt;br&gt;图纸 PDF → PNG → YOLO 标题栏&lt;br&gt;信息提取 → JSON 工件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#117a65;strokeColor=#0e6655;" vertex="1" parent="L1"><mxGeometry x="530" y="36" width="250" height="108" as="geometry"/></mxCell><mxCell id="n_art" value="工件库&lt;br&gt;toc / title_block&lt;br&gt;/ file_list" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;size=12;" vertex="1" parent="L1"><mxGeometry x="820" y="40" width="150" height="100" as="geometry"/></mxCell><mxCell id="n_chk" value="规则校验函数&lt;br&gt;读 Skill.checks&lt;br&gt;set_diff / eq / seq&lt;br&gt;大模型不比对" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;" vertex="1" parent="L1"><mxGeometry x="1010" y="50" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_iss" value="统一 Issue&lt;br&gt;回写报告" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#c0392b;strokeColor=#922b21;" vertex="1" parent="L1"><mxGeometry x="1220" y="50" width="150" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;" edge="1" parent="1" source="n_task" target="n_ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="按 needs 调工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;" edge="1" parent="1" source="n_ctrl" target="n_tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;" edge="1" parent="1" source="n_tools" target="n_art"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;" edge="1" parent="1" source="n_art" target="n_chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;" edge="1" parent="1" source="n_chk" target="n_iss"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2" value="Skill 配置&lt;br&gt;开发只交这个" style="swimlane;horizontal=0;startSize=110;html=1;fontStyle=1;fontSize=13;fontColor=#1a365d;fillColor=#fdebd0;strokeColor=#b9770e;swimlaneFillColor=#fef9f3;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1680" height="220" as="geometry"/></mxCell><mxCell id="sk" value="目录索引一致性  form.toc_index.yaml&lt;br&gt;pack: 形式    level: project&lt;br&gt;needs:  toc · file_list · title_block&lt;br&gt;checks:&lt;br&gt;  · set_diff  目录图号 vs 文件夹&lt;br&gt;  · set_diff  目录图号 vs 标题栏&lt;br&gt;  · eq  字段=阶段   ← 客户可改成「日期」&lt;br&gt;basis: SY/T 0009-2012" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1a365d;fillColor=#ffffff;strokeColor=#7f8c8d;spacing=8;" vertex="1" parent="L2"><mxGeometry x="130" y="30" width="360" height="170" as="geometry"/></mxCell><mxCell id="sk_need" value="needs 告诉总控&lt;br&gt;缺 toc → 调 MinerU&lt;br&gt;缺 title_block → 调 YOLO+抽取&lt;br&gt;标题栏只抽一次&lt;br&gt;三个形式点共用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#e67e22;strokeColor=#ca6f1e;" vertex="1" parent="L2"><mxGeometry x="530" y="50" width="230" height="130" as="geometry"/></mxCell><mxCell id="sk_chk" value="checks 告诉校验函数&lt;br&gt;要比哪些字段&lt;br&gt;用哪个算子&lt;br&gt;不写「先调谁后调谁」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;" vertex="1" parent="L2"><mxGeometry x="800" y="50" width="230" height="130" as="geometry"/></mxCell><mxCell id="sk_del" value="审查点开发交付包&lt;br&gt;1. Skill YAML&lt;br&gt;2. 正例 / 反例各 ≥1&lt;br&gt;3. 回归：期望 Issue 类型与条数&lt;br&gt;禁止新建总控 / 禁止点内调 YOLO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#117a65;strokeColor=#0e6655;" vertex="1" parent="L2"><mxGeometry x="1070" y="50" width="280" height="130" as="geometry"/></mxCell><mxCell id="e6" value="needs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b9770e;fontSize=10;fontColor=#b9770e;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="sk" target="sk_need"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b9770e;fontSize=10;fontColor=#b9770e;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="sk" target="sk_chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d35400;fontSize=10;fontColor=#d35400;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="sk_need" target="n_ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1a5276;fontSize=10;fontColor=#1a5276;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="sk_chk" target="n_chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3" value="编译面&lt;br&gt;平时不触发" style="swimlane;horizontal=0;startSize=110;html=1;fontStyle=1;fontSize=13;fontColor=#1a365d;fillColor=#e8daef;strokeColor=#6c3483;swimlaneFillColor=#f5eef8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1680" height="170" as="geometry"/></mxCell><mxCell id="c_user" value="客户改规则&lt;br&gt;「不校验阶段了&lt;br&gt;改校验日期」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#6c3483;strokeColor=#5b2c6f;" vertex="1" parent="L3"><mxGeometry x="130" y="40" width="180" height="90" as="geometry"/></mxCell><mxCell id="c_agt" value="形式规则转换智能体&lt;br&gt;人话 → 改 Skill.checks&lt;br&gt;stage → date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#5d6d9e;strokeColor=#3d4c7a;" vertex="1" parent="L3"><mxGeometry x="360" y="40" width="220" height="90" as="geometry"/></mxCell><mxCell id="c_human" value="人确认 + 回归&lt;br&gt;用例还过才生效" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#b9770e;strokeColor=#7d6608;" vertex="1" parent="L3"><mxGeometry x="630" y="40" width="180" height="90" as="geometry"/></mxCell><mxCell id="c_write" value="写回审查规则库&lt;br&gt;执行图边不改&lt;br&gt;下次校验吃 date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1a5276;strokeColor=#154360;" vertex="1" parent="L3"><mxGeometry x="860" y="40" width="200" height="90" as="geometry"/></mxCell><mxCell id="c_note" value="needs 没变：YOLO/MinerU 不动&lt;br&gt;needs 变了：总控自动多抽/少抽&lt;br&gt;都不是每人新写一条工作流" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1a365d;fillColor=#ffffff;strokeColor=#7f8c8d;spacing=8;" vertex="1" parent="L3"><mxGeometry x="1100" y="36" width="320" height="100" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c3483;fontSize=10;fontColor=#6c3483;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="c_user" target="c_agt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c3483;fontSize=10;fontColor=#6c3483;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="c_agt" target="c_human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c3483;fontSize=10;fontColor=#6c3483;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="c_human" target="c_write"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c3483;fontSize=10;fontColor=#6c3483;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="c_write" target="p_rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4" value="开发契约" style="swimlane;horizontal=0;startSize=110;html=1;fontStyle=1;fontSize=13;fontColor=#1a365d;fillColor=#fadbd8;strokeColor=#922b21;swimlaneFillColor=#fdedec;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1680" height="110" as="geometry"/></mxCell><mxCell id="do" value="做：把审查点写成 Skill，挂到规则库；缺能力向工具注册中心加插件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#1e8449;strokeColor=#145a32;" vertex="1" parent="L4"><mxGeometry x="130" y="28" width="720" height="56" as="geometry"/></mxCell><mxCell id="dont" value="不做：为目录一致性再起 FastAPI / 再写一套「先转 md 再 YOLO」私有流程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ffffff;fillColor=#922b21;strokeColor=#641e16;" vertex="1" parent="L4"><mxGeometry x="880" y="28" width="720" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>