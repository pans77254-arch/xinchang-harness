Geometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3-开发契约"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="480" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="&lt;b&gt;审查点开发契约（一人一个点，必须按此格式）&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;fontColor=#1a365d;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="800" height="36" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;审查点开发人员&lt;/b&gt;&lt;br&gt;不写总控、不新建智能体" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="pkg" value="&lt;b&gt;提交工作流包&lt;/b&gt;&lt;br&gt;1 workflow.yaml&lt;br&gt;2 正反例图纸&lt;br&gt;3 回归断言" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="200" height="90" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;工作流注册中心&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="180" height="70" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;审查智能体&lt;/b&gt;&lt;br&gt;按包执行" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe599;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="160" height="70" as="geometry"/></mxCell><mxCell id="plat" value="&lt;b&gt;平台组&lt;/b&gt;&lt;br&gt;总控/校验/注册中心/Issue schema" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="220" height="80" as="geometry"/></mxCell><mxCell id="yml" value="&lt;b&gt;workflow.yaml 必填&lt;/b&gt;&lt;br&gt;id / name / pack(形式|pid|总图|关联)&lt;br&gt;level: project | drawing&lt;br&gt;needs: 工件列表（由总控先调检测+提取）&lt;br&gt;steps: 算子 + 字段 + 阈值 + 规范条款&lt;br&gt;on_fail: 交给校验智能体" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="520" height="140" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;已登记算子（没有先申请）&lt;/b&gt;&lt;br&gt;eq regex seq set_diff&lt;br&gt;cypher min_distance llm_judge" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="280" height="140" as="geometry"/></mxCell><mxCell id="iss" value="&lt;b&gt;统一 Issue&lt;/b&gt;&lt;br&gt;issue_id drawing_no skill_id type&lt;br&gt;severity desc basis suggestion x y&lt;br&gt;confidence review_status" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="280" height="140" as="geometry"/></mxCell><mxCell id="ban" value="&lt;b&gt;禁止&lt;/b&gt; 为单个审查点再写总控或 FastAPI · 在点内直接调 YOLO/MinerU 绕过提取智能体 · 私自扩展 Issue 字段 · 审图时走规则转换智能体（那是新规则入库用的）" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1120" height="70" as="geometry"/></mxCell><mxCell id="y1" value="交付" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;strokeColor=#2f5d8a;" edge="1" parent="1" source="dev" target="pkg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="y2" value="注册" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;strokeColor=#2f5d8a;" edge="1" parent="1" source="pk