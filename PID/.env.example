LANGSMITH_TRACING=false

# --- 大模型（二选一） ---
# 1) 内网 vLLM（默认）
# VLM_BASE_URL=http://192.168.31.9:8000/v1
# VLM_MODEL=/data/models
# VLM_API_KEY=EMPTY
# VLM_PROVIDER=vllm

# 2) 阿里云百炼 compatible-mode（当前开发用这个；密钥只放 .env，不要提交）
VLM_BASE_URL=https://llm-6i6h2re056zkn5xq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-27b
VLM_API_KEY=sk-替换为你的密钥
VLM_PROVIDER=dashscope
VLM_TIMEOUT=180

YOLO_WEIGHTS=../best.pt
YOLO_IMGSZ=1280
YOLO_CONF=0.5
YOLO_WEIGHTS_LAYOUT=../best.pt
YOLO_IMGSZ_LAYOUT=1536
YOLO_CONF_NOTES=0.3
PDF_DPI=300

# 说明栏检测：remote（SSH 远程 YOLO）| yolo（本机权重）| label_json（同名标注）
NOTES_DETECT_SOURCE=remote
YOLO_REMOTE_HOST=192.168.31.9
YOLO_REMOTE_PORT=22
YOLO_REMOTE_USER=user
YOLO_REMOTE_PASSWORD=替换为服务器密码
YOLO_REMOTE_WEIGHTS=/data/zzx/图纸处理/runs/cq_layout/weights/best.pt
